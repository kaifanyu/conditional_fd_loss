diff --git a/frechet_distance/losses.py b/frechet_distance/losses.py
index 387cba1..5a4d740 100644
--- a/frechet_distance/losses.py
+++ b/frechet_distance/losses.py
@@ -44,6 +44,21 @@ def diff_all_gather(tensor: torch.Tensor) -> torch.Tensor:
     return _DiffAllGather.apply(tensor)
 
 
+def all_gather_plain(tensor: torch.Tensor) -> torch.Tensor:
+    """All-gather for tensors that carry no gradient (e.g. class labels).
+
+    Concatenates in rank order, matching :func:`diff_all_gather`, so gathered
+    labels stay aligned with gathered features.
+    """
+    if not (torch.distributed.is_available() and torch.distributed.is_initialized()
+            and torch.distributed.get_world_size() > 1):
+        return tensor
+    world_size = torch.distributed.get_world_size()
+    gathered = [torch.zeros_like(tensor) for _ in range(world_size)]
+    torch.distributed.all_gather(gathered, tensor.contiguous())
+    return torch.cat(gathered, dim=0)
+
+
 # =============================================================================
 # Covariance helpers
 # =============================================================================
